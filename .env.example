# =====================================================================
# PARAKH Intelligence Platform - Environment Configuration Template
# =====================================================================

# Application Configuration
APP_NAME=PARAKH
APP_ENV=development
API_PREFIX=/api

# Database Configuration (PostgreSQL in production, SQLite in local development)
DATABASE_URL=sqlite:///./parakh.db
# DATABASE_URL=postgresql+psycopg://parakh_user:secure_password@localhost:5432/parakh

# Security & CORS (Comma-separated or JSON list of allowed origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JWT_SECRET=parakh-super-secure-production-jwt-secret-key-replace-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Risk Engine Thresholds
APPROVAL_THRESHOLD=5000000
PRICE_DEVIATION_THRESHOLD=0.30
NLP_SIMILARITY_THRESHOLD=0.85
TENDER_DURATION_THRESHOLD_DAYS=7
VENDOR_LOCKIN_THRESHOLD=0.60
UNUSUAL_EXTENSION_DAYS=90
RISK_THRESHOLD=70

# Optional Blockchain Ledger Anchoring (Ethereum Sepolia Testnet)
BLOCKCHAIN_ENABLED=false
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
BLOCKCHAIN_PRIVATE_KEY=
BLOCKCHAIN_CONTRACT_ADDRESS=0x742d35Cc6634C0532925a3b844Bc454e4438f44e
